{
  "enabledPlugins": {
    "mcp-server-dev@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"D:/backend AI/.claude/hooks/guard-commands.js\""
          },
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"D:/backend AI/.claude/hooks/precommit-checks.js\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"D:/backend AI/.claude/hooks/audit-log.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"D:/backend AI/.claude/hooks/audit-log.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"D:/backend AI/.claude/hooks/notify.js\" Stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"D:/backend AI/.claude/hooks/notify.js\" Notification"
          }
        ]
      }
    ]
  }
}
