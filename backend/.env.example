# FFMS Node backend — copy to .env and fill in
PORT=4000

# MySQL (the existing ffms database)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=ffms

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MIN=15
REFRESH_EXPIRES_DAYS=7

# Upstream AI microservice
AI_SERVICE_URL=http://localhost:8000

# Frontend origin (for CORS + refresh cookie)
FRONTEND_ORIGIN=http://localhost:3000
