# FFMS AI Microservice — environment configuration
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored, so secrets here will NOT be committed.

# --- MySQL database ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=ffms

# --- CORS ---
# Comma-separated list of allowed origins (your Node.js frontend).
# Must be explicit (no "*") because allow_credentials is enabled.
CORS_ORIGINS=http://localhost:3000

# --- Claude (Anthropic) for RAG expense prediction ---
# The FastAPI service uses Claude to predict next-month spend from retrieved
# history + category context. Falls back to linear regression when unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
