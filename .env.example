# FFMS AI Microservice — environment configuration
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored, so secrets here will NOT be committed.

# --- MySQL database ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=ffms

# --- CORS ---
# Comma-separated list of allowed origins (your Node.js frontend).
# Must be explicit (no "*") because allow_credentials is enabled.
CORS_ORIGINS=http://localhost:3000
