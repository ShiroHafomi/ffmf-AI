# FFMS AI Microservice — environment configuration
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored, so secrets here will NOT be committed.

# --- MySQL database ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=ffms
# Reusable connection pool size (avoids a fresh TCP+auth handshake per query).
DB_POOL_SIZE=10

# --- CORS ---
# Comma-separated list of allowed origins (your Node.js frontend).
# Must be explicit (no "*") because allow_credentials is enabled.
CORS_ORIGINS=http://localhost:3000

# --- Security ---
# Shared secret required in the `X-API-Key` header on every request except "/".
# Leave EMPTY to disable the check (local/trusted-network dev only). In prod,
# set a long random value and have the Node backend send it.
AI_SERVICE_API_KEY=

# Per-IP request cap for the prediction routes (requests per minute).
RATE_LIMIT_PER_MINUTE=60

# --- Response caching ---
# /predict and /insights results are cached in memory for this many seconds.
# Household finance data changes at most monthly, and expense writes (create/
# update/delete) invalidate the household's cache immediately, so a few minutes
# is safe and dramatically cuts DB load + latency. Set 0 to effectively disable.
CACHE_TTL_SECONDS=300

# --- Forecasting: deterministic by default, optional RAG/LLM augmentation ---
# The PRIMARY predictor is a free, offline deterministic model (Linear
# Regression for short series, Holt exponential smoothing + seasonal adjustment
# for longer ones). RAG retrieval (offline TF-IDF over a financial-advice
# corpus) enriches the *suggestions* only — it does NOT drive the number.
#
# An LLM is STRICTLY OPT-IN. It is never called unless you explicitly set
# LLM_PROVIDER below AND supply credentials. Any missing config or call failure
# falls back to the deterministic forecast — no paid calls are ever made.
LLM_PROVIDER=deterministic
# RAG retrieval: how many financial-advice snippets to inject as suggestions.
# Retrieval is a hybrid lexical retriever (TF-IDF word+bigram cosine + a
# situation keyword boost) over an offline financial-knowledge corpus — no
# network or API key needed.
RAG_TOP_K=4
# Sampling temperature for the OPTIONAL LLM generation step. 0 = deterministic
# (recommended for forecasting); raise slightly for more varied phrasing.
RAG_TEMPERATURE=0

# OPTIONAL: free cloud LLM via Groq (OpenAI-compatible). To enable, set
# LLM_PROVIDER=openai-compatible, paste a free key from https://console.groq.com
# below, and keep the base URL / model. If the key is empty or the call fails,
# the service falls back to the deterministic forecast.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# OPTIONAL: other FREE OpenAI-compatible providers. Just change the three vars:
#   Together AI : LLM_BASE_URL=https://api.together.xyz/v1   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OpenRouter  : LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama local (offline, no key): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3  LLM_API_KEY=

# OPTIONAL: paid Claude — EXPLICIT opt-in only. Set LLM_PROVIDER=anthropic
# AND ANTHROPIC_API_KEY; otherwise Claude is never called.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
# Optional tuning (leave defaults if unsure):
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT=20
ANTHROPIC_MAX_RETRIES=1
